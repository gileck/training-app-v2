## Common Patterns Summary

### Pattern 1: Update State and Use Immediately
```typescript
const operation = useCallback(async () => {
  let finalState: Type[] = [];
  
  setState(prev => {
    const updated = prev.map(transform);
    const final = [...updated, newItem];
    finalState = final;
    return final;
  });
  
  await persistToDatabase(finalState);
}, [persistToDatabase]);
```

### Pattern 2: Update Multiple Related States
```typescript
const operation = useCallback(async () => {
  let finalMessages: Message[] = [];
  
  // Update related state first
  setActionHistory(prev => prev.map(updateAction));
  
  // Then update main state with all changes
  setMessages(prev => {
    const updated = prev.map(updateMsg);
    const final = [...updated, systemMsg];
    finalMessages = final;
    return final;
  });
  
  await persist(finalMessages);
}, [persist]);
```

### Pattern 3: Conditional State Updates
```typescript
const operation = useCallback(async (condition: boolean) => {
  let finalState: Type[] = [];
  
  setState(prev => {
    let updated = prev;
    
    if (condition) {
      updated = prev.map(transform);
    }
    
    const final = [...updated, newItem];
    finalState = final;
    return final;
  });
  
  await save(finalState);
}, [save]);
```

