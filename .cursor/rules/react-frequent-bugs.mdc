## Real-World Examples from This Project

### Example 1: AI Chat Persistence Bug

**Bug:** System messages from AI actions (confirm, undo) were not persisting after page refresh.

**Root Cause:**
```typescript
// WRONG
setMessages(prev => prev.map(updateAction));
const updatedMessages = [...messages, systemMessage]; // Stale!
await saveConversation(updatedMessages);
```

**Fix:**
```typescript
// CORRECT
let finalMessages: ChatMessage[] = [];
setMessages(prev => {
  const updated = prev.map(updateAction);
  const final = [...updated, systemMessage];
  finalMessages = final;
  return final;
});
await saveConversation(finalMessages);
```

### Example 2: Parallel Refresh Race Condition

**Bug:** Workouts created by AI appeared briefly then disappeared. Refresh fixed it.

**Root Cause:**
```typescript
// WRONG - Both functions read stale state
const refreshExercises = async (planId) => {
  const exercises = await fetchExercises();
  const currentData = state.planData[planId]; // Stale!
  updateState({
    planData: { ...state.planData, [planId]: { ...currentData, exercises } }
  });
};

const refreshSavedWorkouts = async (planId) => {
  const workouts = await fetchWorkouts();
  const currentData = state.planData[planId]; // Also stale!
  updateState({
    planData: { ...state.planData, [planId]: { ...currentData, savedWorkouts: workouts } }
  });
};

// Called in parallel - race condition!
await Promise.all([refreshExercises(planId), refreshSavedWorkouts(planId)]);
```

**Fix:**
```typescript
// CORRECT - Both use functional updates
const refreshExercises = async (planId) => {
  const exercises = await fetchExercises();
  updateState(prevState => ({
    ...prevState,
    planData: {
      ...prevState.planData,
      [planId]: { ...prevState.planData[planId], exercises }
    }
  }));
};

const refreshSavedWorkouts = async (planId) => {
  const workouts = await fetchWorkouts();
  updateState(prevState => ({
    ...prevState,
    planData: {
      ...prevState.planData,
      [planId]: { ...prevState.planData[planId], savedWorkouts: workouts }
    }
  }));
};

// Now both updates properly merge!
await Promise.all([refreshExercises(planId), refreshSavedWorkouts(planId)]);
```

